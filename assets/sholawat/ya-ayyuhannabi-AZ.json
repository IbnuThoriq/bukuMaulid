{
  "id": "YaAyyuhanNabi",
  "judul": "Ya Ayyuhan Nabi",
  "grup": "Umum",
  "kategori": "Sholawat",
  "audio": "",
  "bait": [
    {
      "arab": "يَا أَيُّهَا النَّبِي * وَالْكَوْكَبُ الدُّرِّي",
      "latin": "Yaa ayyuhan-nabiyyu wal kawkabud-durriyyu",
      "arti": "Wahai Nabi dan bintang yang berkilauan"
    },
    {
      "arab": "أَنْتَ إِمَامُ الْحَضْرَة * سُلْطَانُهَا الْغَيْبِي",
      "latin": "Anta imaamul hadhrah, sulthaanuhal ghaibbiyy",
      "arti": "Engkau adalah imam dalam majelis (kehadiran ilahi) dan penguasa bahagian gaibnya"
    },
    {
      "arab": "فَإِنِّي عَبْدٌ * حِمْلِي ثَقِيلٌ",
      "latin": "Fa innii 'abdun, himlii tsaqiilun",
      "arti": "Sesungguhnya aku adalah seorang hamba yang bebannya sangat berat"
    },
    {
      "arab": "وَ لِي ذُنُوبٌ * مِثْلَ الرِّمَالِ",
      "latin": "Wa lii dzunuubun mithlar-rimaali",
      "arti": "Dan aku memiliki dosa-dosa sebanyak hamparan pasir"
    },
    {
      "arab": "وَصَلِّ دَوْمًا * عَلَى نَبِيِّنَا",
      "latin": "Wa shalli dawman 'alaa nabiyyinaa",
      "arti": "Dan limpahkanlah sholawat senantiasa kepada Nabi kami"
    },
    {
      "arab": "طٰهَ الْمُمَجَّد * بَاهِي الْجَمَالِ",
      "latin": "Thoohal mumajjad, baahil jamaali",
      "arti": "Thaha yang diagungkan dan pemilik keindahan yang mempesona"
    },
    {
      "arab": "يَا مَنْ يَرَانِي * وَلَا أَرَاهُ",
      "latin": "Yaa man yaraanii wa laa araahu",
      "arti": "Wahai Dzat yang melihatku sedangkan aku tidak dapat melihat-Nya"
    },
    {
      "arab": "اُنْظُرْ بِعَيْنِ * الرِّضَا لِحَالِي",
      "latin": "Unzhur bi'ainir-ridhaa lihaalii",
      "arti": "Pandanglah keadaanku dengan pandangan keridhaan-Mu"
    }
  ]
}

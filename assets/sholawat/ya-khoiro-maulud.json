  "bait": [
    {
      "arab": "يَا خَيْرَ مَوْلُودٍ بِمَكَّةَ قَدْ أَتَى",
      "latin": "Yaa khoiro mauluudin bimakkata qod ataa",
      "arti": "Wahai sebaik-baik bayi yang lahir di Makkah telah datang"
    },
    {
      "arab": "ذَلَّتْ لِهَيْبَتِهِ جَمِيعُ خُصُومِهِ",
      "latin": "Dzallat lihaibatihii jamii'u khushuumih",
      "arti": "Tunduklah karena wibawanya seluruh musuhnya"
    },
    {
      "arab": "يَا خَيْرَ مَوْلُودٍ ... يَا نَبِيَّنَا",
      "latin": "Yaa khoiro mauluudin ... yaa nabiyyanaa",
      "arti": "Wahai sebaik-baik bayi yang dilahirkan... Wahai nabi kami"
    },
    {
      "arab": "ضَاءَتْ بِهِ كُلُّ الْعَوَالِمِ جَهْرَةً",
      "latin": "Dloo'at bihii kullul 'awaalimi jahrotan",
      "arti": "Seluruh alam semesta terang benderang karenanya secara nyata"
    },
    {
      "arab": "وَالْكَوْنُ أَصْبَحَ مُشْرِقًا بِقُدُومِهِ",
      "latin": "Wal kaunu ashbaha musyriqon biquduumih",
      "arti": "Dan alam semesta menjadi bersinar dengan kedatangannya"
    },
    {
      "arab": "يَا خَيْرَ مَوْلُودٍ ... يَا نَبِيَّنَا",
      "latin": "Yaa khoiro mauluudin ... yaa nabiyyanaa",
      "arti": "Wahai sebaik-baik bayi yang dilahirkan... Wahai nabi kami"
    },
    {
      "arab": "هَذَا الْحَبِيبُ الْمُصْطَفَى طٰهَ الَّذِي",
      "latin": "Haadzal habiibul musthofaa Thoohal ladzii",
      "arti": "Inilah kekasih pilihan, Thaha yang mana"
    },
    {
      "arab": "كُلُّ الْعَوَالِمِ قَدْ بَدَتْ مِنْ نُوْرِهِ",
      "latin": "Kullul 'awaalimi qod badat min nuurih",
      "arti": "Seluruh alam tampak dari cahayanya"
    },
    {
      "arab": "يَا خَيْرَ مَوْلُودٍ ... يَا نَبِيَّنَا",
      "latin": "Yaa khoiro mauluudin ... yaa nabiyyanaa",
      "arti": "Wahai sebaik-baik bayi yang dilahirkan... Wahai nabi kami"

{
  "id": "YaKhoiroHadi",
  "judul": "Ya Khoiro Hadi",
  "grup": "Muhibbus Sholawat",
  "kategori": "Sholawat",
  "audio": "",
  "bait": [
    {
      "arab": "يَا خَيْرَ هَادِي لِلْأَنَامِ تَسَمَّا",
      "latin": "Yaa khoiro haadii lil-anaami tasammaa",
      "arti": "Wahai sebaik-baik pemberi petunjuk, engkau dinamai untuk seluruh manusia"
    },
    {
      "arab": "عَطْفًا عَلَى",
      "latin": "'Athfan 'alaa",
      "arti": "Berilah belas kasih kepada"
    },
    {
      "arab": "مَنْ ذَابَ فِيْكَ غَرَامَا",
      "latin": "Man dzaaba fiika ghoroomaa",
      "arti": "Orang yang meleleh karena cinta mendalam padamu"
    },
    {
      "arab": "أَنْتَ الَّذِي شَرَّفْتَ كُلَّ مُشَرَّفٍ",
      "latin": "Antal ladzii syarrofta kulla musyarrofin",
      "arti": "Engkaulah yang telah memuliakan setiap yang dimuliakan"
    },
    {
      "arab": "وَمَنَحْتَنَا",
      "latin": "Wa manahtanaa",
      "arti": "Dan engkau telah menganugerahkan kepada kami"
    },
    {
      "arab": "يَاذَى النَّدَى يَا إِمَامَا",
      "latin": "Yaa dzan-nadaa yaa imaamaa",
      "arti": "Wahai pemilik kedermawanan, wahai pemimpin"
    },
    {
      "arab": "يَا سَيِّدَ الْكَوْنَيْنِ يَا عَلَمَ الْهُدَى",
      "latin": "Yaa sayyidal kaunaini yaa 'alamal hudaa",
      "arti": "Wahai pemimpin dua alam, wahai bendera petunjuk"
    },
    {
      "arab": "يَا مَنْ أَتَى",
      "latin": "Yaa man ataa",
      "arti": "Wahai yang datang"
    },
    {
      "arab": "لِلْمُرْسَلِيْنَ خِتَامَا",
      "latin": "Lil-mursaliina khitaamaa",
      "arti": "Sebagai penutup para Rasul"
    }
  ]
}
